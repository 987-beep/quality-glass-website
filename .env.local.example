# Copy to .env.local and fill in your InsForge project values.
# These are SERVER-SIDE ONLY — the browser never holds any project credential;
# it talks to this site's own /api relay routes which attach the key.

INSFORGE_URL=https://your-project.ap-southeast.insforge.app
INSFORGE_API_KEY=ik_xxxxxxxxxxxxxxxxxxxx

# Optional — only used by one-off migration/admin scripts.
INSFORGE_DATABASE_URL=
